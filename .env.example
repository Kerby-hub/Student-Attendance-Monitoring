# Supabase configuration for the Student Attendance Monitoring System.
# Copy this file to `.env` and fill in the values from your Lovable Cloud /
# Supabase project. The `.env` file is git-ignored and must never be committed.
#
# Frontend (Vite) — exposed to the browser. Only public/publishable keys here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-REF

# Alias accepted by some tooling — set to the same value as the publishable key.
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-side (SSR / server functions). NEVER prefix secrets with VITE_.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_PROJECT_ID=YOUR-PROJECT-REF

# Service role key — SECRET. Bypasses RLS. Server-only. Do not expose to the client.
# On Lovable Cloud this is managed for you and is not retrievable from the dashboard.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
